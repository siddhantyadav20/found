  "lines": [
   {
    "who": "Sameer-low",
    "at": 4,
    "text": "भसीन सर, यहाँ?"
   },
   {
    "who": "Bhasin",
    "at": 6,
    "text": "हाँ। सब कुछ। उसके कपड़े भी।"
   },
   {
    "who": "Bhasin",
    "at": 29,
    "text": "जल्दी करो।"
   }
  ]
 },
 {

   }
  ]
 },
 {
  "key": "msg:mc-1",
  "style": "call",
  "seconds": 3,
  "lines": [
   {
    "who": "Meera",
    "at": 0.6,
    "text": "…ठीक है। आप जो भी हो।"
   }
  ]
 },
 {
  "key": "msg:mc-2",
  "style": "call",
  "seconds": 2,
  "lines": [
   {
    "who": "Meera",
    "at": 0.6,
    "text": "…हाँ। पता है।"
   }
  ]
 },
 {
  "key": "msg:mc-3",
  "style": "call",
  "seconds": 3,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "क्योंकि मैं उसका कन्फ़ेशन बॉक्स नहीं हूँ।"
   }
  ]
 },
 {
  "key": "msg:mc-3a",
  "style": "call",
  "seconds": 1.6,
  "lines": [
   {
    "who": "Meera",
    "at": 0.4,
    "text": "आप जो भी हो।"
   }
  ]
 },
 {
  "key": "msg:mc-4",
  "style": "call",
  "seconds": 3,
  "lines": [
   {
    "who": "Meera",
    "at": 1.5,
    "text": "पता है। पहले शब्द से।"
   }
  ]
 },
 {
  "key": "call:meera:meera-keep:0",
  "style": "call",
  "seconds": 5,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "उसकी माँ का फ़ोन आया था। फ़ोन घर पे है, और वो उठा नहीं रहा।"
   }
  ]
 },
 {
  "key": "call:meera:meera-keep:1",
  "style": "call",
  "seconds": 9,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "मैंने आज सुबह ये लेने से मना किया था। दो महीने से बात नहीं की, और आज ये भेज दिया। मैं अब उसका बोझ नहीं उठाती।"
   }
  ]
 },
 {
  "key": "call:meera:meera-keep:2",
  "style": "call",
  "seconds": 5,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "वो हमेशा यही करता है। जब कुछ संभलता नहीं, तो, मैं नहीं था।"
   }
  ]
 },
 {
  "key": "call:meera:meera-keep:3",
  "style": "call",
  "seconds": 6,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "लेकिन अगर ये आपके हाथ में है, तो एक काम करना। कुछ डिलीट मत करना। कुछ भी।"
   }
  ]
 },
 {
  "key": "call:meera:meera-keep-early:0",
  "style": "call",
  "seconds": 4,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "तो सुन। कुछ डिलीट मत करना। कुछ भी।"
   }
  ]
 },
 {
  "key": "msg:mc-why",
  "style": "call",
  "seconds": 5,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "क्योंकि जो इसे भेजता है, वो सबसे पहले वही मिटाता है जो उसे फँसाता है।"
   }
  ]
 },
 {
  "key": "msg:mc-close",
  "style": "call",
  "seconds": 7,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "उसके पासवर्ड्स उसकी बर्थडे होते हैं। हमेशा।"
   },
   {
    "who": "Meera",
    "at": 3.4,
    "text": "और ऑर्डर में देखना। उसने ऑर्डर में रखा है।"
   }
  ]
 },
 {
  "key": "msg:mc-close-early",
  "style": "call",
  "seconds": 4,
  "lines": [
   {
    "who": "Meera",
    "at": 0,
    "text": "और ऑर्डर में देख। तूने ऑर्डर में रखा है।"
   }
  ]
 },
 {
  "key": "voice:b-vn-stranger",
  "style": "note",
  "seconds": 14,
  "lines": [
   {
    "who": "Bhasin",
    "at": 0.5,
    "text": "जिसके पास भी ये फ़ोन है।"
   },
   {
    "who": "Bhasin",
    "at": 3,
    "text": "नीलम जी कह रही थी कोई और है। अच्छा नाटक है।"
   },
   {
    "who": "Bhasin",
    "at": 8,
    "text": "सुबह सात बजे तक फ़ोन गेट दो पे छोड़ देना। बाक़ी हम देख लेंगे।"
   }
  ]
 },
 {
  "key": "voice:b-vn-fine",
  "style": "note",
  "seconds": 9,
  "lines": [
   {
    "who": "Bhasin",
    "at": 0.5,
    "text": "नीलम जी ने बताया तू ठीक है। अच्छा है।"
   },
   {
    "who": "Bhasin",
    "at": 4.5,
    "text": "तो घर पे ही रहना। सुबह बात करते हैं।"
   }
  ]
 },
 {
  "key": "voice:b-vn-none",
  "style": "note",
  "seconds": 11,
  "lines": [
   {
    "who": "Bhasin",
    "at": 0.5,
    "text": "जिसके पास भी ये फ़ोन है।"
   },
   {
    "who": "Bhasin",
    "at": 3,
    "text": "नीलम जी का फ़ोन लोकेशन दिखा रहा है। बी चौदह।"
   },
   {
    "who": "Bhasin",
    "at": 7.5,
    "text": "सुबह सात बजे तक गेट दो पे छोड़ देना।"
   }
  ]
 },
 {
  "key": "voice:b-gate",
  "style": "note",
  "seconds": 8,
  "lines": [
   {
    "who": "Bhasin",
    "at": 0.4,
    "text": "समीर।"
   },
   {
    "who": "Bhasin",
    "at": 4,
    "text": "गेट दो पे हूँ। नीचे आ। बात करनी है।"
   }
  ]
 },
 {
  "key": "voice:b-terms",
  "style": "note",
  "seconds": 34,
  "lines": [
   {
    "who": "Bhasin",
    "at": 0.5,
    "text": "समीर। अब तुझे पता है लड़का ज़िंदा है। तो सीधी बात।"
   },
   {
    "who": "Bhasin",
    "at": 6,
    "text": "फ़ोन गार्ड के हाथ नीचे भेज दे। सात बजे लड़का समस्तीपुर की बस में होगा। ज़िंदा, दवाई के साथ, पैसे के साथ।"
   },
   {
    "who": "Bhasin",
    "at": 15,
    "text": "तू चार पचपन की ट्रेन पकड़। रंगमंच में मैंने बात कर ली है, वहाँ सब ठीक रहेगा।"
   },
   {
    "who": "Bhasin",
    "at": 21,
    "text": "कुणाल वाला वीडियो मेरे पास रहेगा। बस मेरे पास रहेगा।"
   },
   {
    "who": "Bhasin",
    "at": 26,
    "text": "और अगर फ़ोन नीचे नहीं आया… तो लड़का भी कहीं नहीं जाएगा। आधा घंटा है।"
   }
  ]
 },
 {
  "key": "voice:an-v",
  "style": "whisper",
  "seconds": 26,
  "lines": [
   {
    "who": "Anita",
    "at": 0.5,
    "text": "एक लड़का है। एक हफ़्ते से।"
   },
   {
    "who": "Anita",
    "at": 3.5,
    "text": "रजिस्टर में दीपक, उन्नीस साल, रोड एक्सीडेंट लिखा है।"
   },
   {
    "who": "Anita",
    "at": 8,
    "text": "रोड एक्सीडेंट नहीं है। गोली का घाव है, कंधे में।"
   },
   {
    "who": "Anita",
    "at": 12.5,
    "text": "जो लोग लाए थे, रोज़ आते हैं। आज रात बोले सुबह सात बजे ले जाएँगे। कहाँ, नहीं बताया।"
   },
   {
    "who": "Anita",
    "at": 20,
    "text": "वो रोज़ एक ही नाम लेता है। समीर भैया।"
   }
  ]
 },
 {
  "key": "voice:an-4",
  "style": "whisper",
  "seconds": 17,
  "lines": [
   {
    "who": "Dilip-weak",
    "at": 0.5,
    "text": "भैया… आप आ रहे हो ना?"
   },
   {
    "who": "Dilip-weak",
    "at": 3.5,
    "text": "उन्होंने बोला है अगर मैं कुछ नहीं बोलूँगा तो घर भेज देंगे। मैं कुछ नहीं बोलूँगा।"
   },
   {
    "who": "Dilip-weak",
    "at": 10.5,
    "text": "माँ को मत बताना कि गोली लगी थी।"
   },
   {
    "who": "Dilip-weak",
    "at": 14,
    "text": "बस… आप आ जाओ।"
   }
  ]
 },
 {

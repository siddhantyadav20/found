 {
  "key": "call:raju:1",
  "style": "call",
  "seconds": 4,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "…हेलो? आप कौन? ये समीर भैया का फ़ोन है ना?"
   }
  ]
 },
 {
  "key": "msg:rc-1",
  "style": "call",
  "seconds": 5,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "तो समीर भैया कहाँ हैं? सात दिन से फ़ोन कर रहा हूँ।"
   }
  ]
 },
 {
  "key": "msg:rc-2",
  "style": "call",
  "seconds": 5,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "वक़्त? सात दिन हो गए… ठीक है। मैं फिर करूँगा।"
   }
  ]
 },
 {
  "key": "msg:rc-3",
  "style": "call",
  "seconds": 3,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "दिलीप कौन? दिलीप कौन?!"
   }
  ]
 },
 {
  "key": "call:raju-2:0",
  "style": "call",
  "seconds": 1.2,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "हेलो?"
   }
  ]
 },
 {
  "key": "call:raju-2:1",
  "style": "call",
  "seconds": 4,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "आप ही हो ना? जिसने पिछली बार फ़ोन उठाया था?"
   }
  ]
 },
 {
  "key": "call:raju-2:2",
  "style": "call",
  "seconds": 4,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "दिलीप के बारे में कुछ पता चला? माँ रोज़ फ़ोन करती है।"
   }
  ]
 },
 {
  "key": "msg:r-9",
  "style": "call",
  "seconds": 2,
  "lines": [
   {
    "who": "Raju",
    "at": 0.8,
    "text": "…ज़िंदा है?"
   }
  ]
 },
 {
  "key": "msg:r-10",
  "style": "call",
  "seconds": 3,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "पक्की? …वो भी यही बोलता था।"
   }
  ]
 },
 {
  "key": "msg:r-code",
  "style": "call",
  "seconds": 6,
  "lines": [
   {
    "who": "Raju",
    "at": 0,
    "text": "वो रोज़ पूछता था, मुंबई पक्की ना? हर बार। पक्की, पक्की।"
   }
  ]
 },
 {
  "key": "msg:r-11",
  "style": "call",
  "seconds": 2,
  "lines": [

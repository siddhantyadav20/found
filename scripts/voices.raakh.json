[
 {
  "key": "voice:m-1",
  "style": "note",
  "seconds": 18,
  "lines": [
   {
    "who": "Sameer-low",
    "at": 0.4,
    "text": "एम… मैं जानता हूँ तू रिप्लाई नहीं करेगी।"
   },
   {
    "who": "Sameer-low",
    "at": 5,
    "text": "कल शादी में… कुणाल फ़ायरिंग कर रहा था।"
   },
   {
    "who": "Sameer-low",
    "at": 11,
    "text": "एक लड़का गिर गया।"
   }
  ]
 },
 {
  "key": "voice:m-2",
  "style": "note",
  "seconds": 11,
  "lines": [
   {
    "who": "Sameer-low",
    "at": 0.5,
    "text": "उसको हॉस्पिटल नहीं ले गए।"
   },
   {
    "who": "Sameer-low",
    "at": 4.5,
    "text": "भसीन ने किसी को जाने नहीं दिया।"
   }
  ]
 },
 {
  "key": "voice:m-3",
  "style": "note",
  "seconds": 9,
  "lines": [
   {
    "who": "Sameer-low",
    "at": 0.6,
    "text": "उन्होंने उसको जला दिया, एम।"
   },
   {
    "who": "Sameer-low",
    "at": 4.5,
    "text": "मैं वहाँ था। मैंने देखा।"
   }
  ]
 },
 {
  "key": "voice:m-4",
  "style": "note",
  "seconds": 6,
  "lines": [
   {
    "who": "Sameer-low",
    "at": 0.4,
    "text": "अगर मुझे कुछ हुआ… सब फ़ोन में है।"
   }
  ]
 },
 {
  "key": "memo:memo-rangmanch",
  "style": "memo",
  "seconds": 16,
  "lines": [
   {
    "who": "Sameer",
    "at": 1,
    "text": "मैं शादियाँ प्लान करता हूँ, पर मेरा हर फ़ंक्शन एक फ़िल्म जैसा होता है।"
   },
   {
    "who": "Sameer",
    "at": 7,
    "text": "नहीं। फिर से। …मैं शादियों में कहानियाँ ढूँढता हूँ।"
   }
  ]
 },
 {
  "key": "memo:memo-458",
  "style": "memo",
  "seconds": 14,
  "lines": [
   {
    "who": "Sameer-low",
    "at": 3,
    "text": "पहली कैमरे के लिए थी।"
   },
   {
    "who": "Sameer-low",
    "at": 7,
    "text": "दूसरी… मैं पोज़ कर रहा था।"
   },
   {
    "who": "Sameer-low",
    "at": 11,
    "text": "मुझे लगा ख़ाली है।"
   }
  ]
 },
 {
  "key": "memo:memo-code",
  "style": "memo",
  "seconds": 16,
  "lines": [
   {
    "who": "Sameer-low",
    "at": 2,
    "text": "एम। नितिन और दिलीप की चैट मैंने लॉक कर दी है।"
   },
   {
    "who": "Sameer-low",
    "at": 7,
    "text": "कोड वो है… जो वो रोज़ पूछता था। और जो मैंने उससे कहा।"
   },
   {
    "who": "Sameer-low",
    "at": 13,
    "text": "नहीं। रहने दे।"
   }
  ]
 },
 {
  "key": "clip:reel-take",
  "style": "clip",
  "seconds": 14,
  "lines": [
   {
    "who": "Kunal",
    "at": 1,
    "text": "रोलिंग, भाई?"
   },
   {
    "who": "Sameer",
    "at": 2,
    "text": "हाँ। लाइट ऊपर, दिलीप।"
   },
   {
    "who": "Dilip",
    "at": 4,
    "text": "भैया… मुंबई पक्की ना?"
   },
   {
    "who": "Sameer",
    "at": 5.5,
    "text": "पक्की। अब हिलना मत।"
   },
   {
    "who": "Sameer",
    "at": 11,
    "text": "एक और, पोज़ में—"
   }
  ]
 },
 {

# Copy to `.env.local` and fill in. Nothing here is required to run Found
# locally — every value has a working fallback.
#
# REMEMBER: .env.local is not Vercel. Every variable the deployed app needs has
# to be added in the Vercel project's settings too, and only reaches the next
# deploy.

# The canonical origin: metadataBase, OG image URLs, the sitemap, robots.txt.
# Unset, Vercel uses the project's production domain
# (VERCEL_PROJECT_PRODUCTION_URL); `next dev` and a local build fall back to
# http://localhost:3001; any other build with CI=true fails (see lib/origin.ts).
# Server-only; the older NEXT_PUBLIC_SITE_URL name is still read.
SITE_URL=

# "Tell me when the next episode is out" (components/found/FoundPhone/submit.ts).
# Without a key the address is written to the server log instead of mailed.
RESEND_API_KEY=
# Optional. Where the mail goes, and who it's from. Defaults in lib/mail.ts
# and submit.ts. Resend's shared domain only delivers to the key owner.
WAITLIST_TO=
WAITLIST_FROM=

# The funnel (lib/found/store.ts, app/api/found). Locally, leave both blank:
# `next dev` falls back to an in-memory store (lib/upstashDev.ts) that empties
# on restart. In production, add an Upstash Redis through the Vercel
# Marketplace and these are injected for you (the KV_REST_API_* pair also works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salts the hash that stands in for a visitor in the funnel's rate limit, so no
# store holds an IP address (lib/visitorId.ts).
ENGAGEMENT_SALT=

# Reading the funnel back: GET /api/found?token=<this>. Open in `next dev`;
# unset in production means the GET is a 404.
FOUND_STATS_TOKEN=
